# Copy to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — enables "Import from LeetCode". URL of your deployed
# leetcode-proxy edge function (see supabase/README.md):
# VITE_LEETCODE_PROXY_URL=https://your-project.supabase.co/functions/v1/leetcode-proxy

# optional — enables the second-opinion feedback block on /ats and the
# floating assistant widget's chat, free key at console.groq.com
VITE_GROQ_API_KEY=

# optional — gives the assistant widget's floating button a 3D avatar
# instead of a plain icon. Publish a scene at spline.design and paste its
# "Export > Code > Viewer" URL (ends in .splinecode).
VITE_SPLINE_SCENE_URL=
